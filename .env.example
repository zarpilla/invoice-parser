# Invoice Parser API Configuration

# Port for the API server (default: 4000)
PORT=4000

# API Tokens (comma-separated list)
# Generate secure tokens: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKENS=your-secret-token-1,your-secret-token-2

# Example with multiple tokens:
# API_TOKENS=abc123def456,xyz789uvw012,client-a-token,client-b-token

# Z.ai (Zhipu AI) key, used for both stages:
#   - GLM-OCR (`layout_parsing`), only for scanned PDFs without a text layer
#   - the chat model that turns the invoice text into JSON
# Paid models bill the pay-as-you-go balance (~$0.0003 per invoice with the default).
ZAI_API_KEY=

# Optional overrides (sane defaults are used if left blank):
# Base URL : https://api.z.ai/api/paas/v4/
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# Model    : glm-5.3-flash (best in the 2026-11-06 benchmark). The free glm-4.7-flash
#            is overloaded / rate-limited most of the time.
# ZAI_MODEL=glm-5.3-flash
# Thinking : low (default for glm-5.3*, which cannot disable it), high, max or disabled
# ZAI_THINKING=low
# Whole request budget in ms (OCR + retries); the Strapi proxy waits 120 s
# PARSE_DEADLINE_MS=90000
